<Window x:Class="AirPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirPad Server" Height="450" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseCircle" 
                             Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0.0" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="PulseCircleScale" 
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.5" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="PulseCircleScale" 
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.5" Duration="0:0:1.5" />
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="20" Background="#121212" BorderBrush="#333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <!-- Custom title bar for dragging -->
            <Grid VerticalAlignment="Top" Height="40" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="10">
                <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="Transparent" Foreground="#888" BorderThickness="0" FontSize="16" Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#333"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid x:Name="WaitingGrid" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="AIRPAD" Foreground="White" FontSize="32" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Ready to connect" Foreground="#888" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    
                    <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <Ellipse x:Name="PulseCircle" Fill="#007ACC" Opacity="0.8">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PulseCircleScale" CenterX="60" CenterY="60" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Fill="#121212" Width="110" Height="110" />
                        <TextBlock x:Name="PinTextBlock" Text="----" Foreground="#007ACC" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="ConnectedGrid" Visibility="Collapsed" Opacity="0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Success Icon -->
                    <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Fill="#4CAF50" Opacity="0.2"/>
                        <Path Data="M 25 50 L 45 70 L 75 30" Stroke="#4CAF50" StrokeThickness="6" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Connected Successfully" Foreground="#4CAF50" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    
                    <Border Background="#1E1E1E" CornerRadius="12" Padding="24,16" MinWidth="200" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="DeviceNameText" Text="Unknown Device" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="DeviceTypeText" Text="Unknown OS" Foreground="#888" FontSize="14" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <Button Content="Disconnect" Width="120" Height="36" Margin="0,24,0,0"
                            Background="#D32F2F" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold"
                            Click="DisconnectButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E53935"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
